# tracecart-web — copy to .env.local and fill in.

# --- Required ----------------------------------------------------------------
# The API as browsers reach it. NEXT_PUBLIC_* values are compiled into the
# browser bundle: changing them means rebuilding (the Docker image too).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Clerk (sign-in): Clerk dashboard -> API keys. Same Clerk app as the API's.
# Read by @clerk/nextjs; the secret key stays on the server.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Optional ----------------------------------------------------------------
# Server-side calls (session lookup, the API proxy) on a private network,
# e.g. http://api:4000 in docker-compose. Unset: NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=

# --- Building on small machines ------------------------------------------------
# NEXT_BUILD_CPUS=1         cap build workers when memory is short
# NEXT_SKIP_TYPECHECK=1     skip the build's own type check (run `pnpm typecheck` instead)
# NEXT_OUTPUT=standalone    self-contained server bundle (the Dockerfile sets it)

# --- API contract (pnpm api:sync / api:check) -----------------------------------
# Where the API's openapi.json is: a path or an https URL.
# Default: ../tracecart-api/openapi.json (both repos checked out side by side).
# TRACECART_API_SPEC=

# --- Browser tests (pnpm test:e2e) ------------------------------------------------
# TRACECART_API_DIR=../tracecart-api   the API checkout the tests build and start
# E2E_WEB_URL=http://localhost:3000
# E2E_API_URL=http://localhost:4000
