    "next": "^16.1.6",
    "next-intl": "^4.14.9",
    "openapi-fetch": "^0.14.1",
    "react": "^19.2.0",
    "react-apexcharts": "^1.8.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.64.1",
    "@svgr/webpack": "^8.1.0",
